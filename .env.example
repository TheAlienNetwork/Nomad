# HUNT//OS environment
# Copy to apps/web/.env.local. Do not commit secrets.

# Optional: LLM explanation layer. Scoring still runs without this.
# The model is never allowed to invent GIS, property, or legal facts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET=
SESSION_DAYS=30

# Durable account/waypoint file (single-node). Back this up.
HUNTOS_DATA_FILE=

# Optional future auth provider.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Expo Hunt (apps/mobile) — per-user memoir, gear, map marks, and journal prefs.
# Copy these into apps/mobile/.env. Data stays on-device until the hunter signs in.
# API URL is https://<project-ref>.supabase.co — not the db.*.supabase.co host.
# Play Internal Testing package (never change after first upload): com.nomad.field
# Put EXPO_PUBLIC_SUPABASE_* in EAS secrets for release builds — do not commit .env.
# Host the in-app privacy text (apps/mobile/app/privacy.tsx) at a public URL for Play Console.
EXPO_PUBLIC_SUPABASE_URL=https://vqdvfxfzhsbhmfumvncy.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Expo identify / weather / scout / terrain against apps/web (no trailing slash).
EXPO_PUBLIC_HUNTOS_API_URL=

# Optional S3-compatible object storage for photos.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Production geospatial database. Schema lives in packages/db/migrations.
DATABASE_URL=

# Override official GIS endpoints only if an agency URL changes.
# Leave empty to use dataset-registry defaults (USGS National Map / PAD-US).
PADUS_FEATURE_URL=
PADUS_MAPSERVER_URL=
USGS_TOPO_TILE_URL=
USGS_IMAGERY_TILE_URL=
USGS_HILLSHADE_TILE_URL=
# Public Mapzen/AWS Terrarium DEM (no key). Override only if the tile host changes.
TERRARIUM_TILE_URL=

# Weather / elevation (Open-Meteo, no key required). Override only if needed.
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# Official TPWD white-tailed deer management units (MapServer, not seasons/regs).
# Mule deer: .../Wildlife/TPWD_WL_MDMU/MapServer  Pronghorn: .../Wildlife/TPWD_WL_PMU/MapServer
TPWD_HUNTING_UNITS_URL=https://tpwd.texas.gov/server/rest/services/Wildlife/TPWD_WL_WTDMU/MapServer/0

# Official TPWD Public Hunt Locator (listed public hunt areas, not permission/seasons).
TPWD_PUBLIC_HUNT_URL=https://tpwd.texas.gov/server/rest/services/Wildlife/TPWD_PublicHuntLocatorMap/MapServer

# Optional hydrography / roads / land-cover. Empty means the factor stays unknown.
# NHD defaults live in packages/core/src/registry.ts when these are blank.
NHD_WATERBODY_URL=
NHD_FLOWLINE_URL=
# USGS TNM Local Roads. Fallback layers: /31 connecting, /30 secondary, /29 highways.
TNM_ROADS_URL=https://carto.nationalmap.gov/arcgis/rest/services/transportation/MapServer/32
# MRLC NLCD WMS (raster). Scout records the source; pixel identify is not wired yet.
NLCD_URL=https://www.mrlc.gov/geoserver/mrlc_display/wms
